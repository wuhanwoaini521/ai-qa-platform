# ==============================================================================
# AI QA Platform — Production Environment Configuration Template
# Copy this file to .env and configure the secrets for your environment.
# ==============================================================================

# --- Application & Network ---
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=production
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://qa.yourdomain.com"]

# --- Database (PostgreSQL / SQLite) ---
# For PostgreSQL (Production):
DATABASE_URL=postgresql+asyncpg://aiqa:aiqa_secret_password@postgres:5432/ai_qa_platform
POSTGRES_DB=ai_qa_platform
POSTGRES_USER=aiqa
POSTGRES_PASSWORD=aiqa_secret_password

# For Local SQLite Dev:
# DATABASE_URL=sqlite+aiosqlite:///./runtime/ai_qa_platform.db

# --- Security & Authentication ---
SECURITY_JWT_SECRET=super-secret-jwt-key-replace-in-production-minimum-32-chars
SECURITY_TOKEN_EXPIRE_MINUTES=1440
DEFAULT_ADMIN_EMAIL=admin@ai-qa.local
DEFAULT_ADMIN_PASSWORD=Admin@AI-QA-2026!

# --- Artifact & Storage (MinIO / AWS S3) ---
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_NAME=ai-qa-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Production AI Providers ---
# Options: mock | openai | anthropic | gemini
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# AI Rate Limiting and Token Budgets
AI_MONTHLY_BUDGET_USD=500.00
AI_RATE_LIMIT_RPM=60

# --- Integrations (Optional) ---
# GitHub Integration
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Jira Integration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=
JIRA_API_TOKEN=

# TestRail Integration
TESTRAIL_BASE_URL=https://your-domain.testrail.io
TESTRAIL_USERNAME=
TESTRAIL_API_KEY=

# Jenkins CI Integration
JENKINS_URL=http://jenkins:8080
JENKINS_USER=
JENKINS_API_TOKEN=

# --- Distributed Worker Configuration ---
AI_QA_API_URL=http://api:8000
WORKER_NAME=Runner-Node-1
MAX_CONCURRENCY=4
WORKER_CAPABILITIES=playwright,chromium,firefox,webkit,pytest,python3
HEARTBEAT_INTERVAL_SECONDS=10.0
POLL_INTERVAL_SECONDS=3.0
