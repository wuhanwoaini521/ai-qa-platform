# Deployment inputs and provider overrides referenced by config/config.yaml.
# Process environment values override YAML; unset values leave the YAML policy in effect.

# API bind address used by the container entrypoint.
API_HOST=0.0.0.0
API_PORT=8000

# Set strong values before deployment. Compose requires the database and app secrets.
APP_SECRET_KEY=replace-with-a-random-value-of-at-least-32-characters
POSTGRES_DB=ai_qa_platform
POSTGRES_USER=aiqa
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Provider settings (defaults intentionally match config/config.yaml).
QA_AI_ENABLED=true
QA_AI_PROVIDER=openai-compatible
QA_AI_API_KEY=
QA_AI_BASE_URL=https://api.deepseek.com
QA_AI_MODEL=deepseek-flash
QA_AI_TIMEOUT_SECONDS=30
QA_AI_MAX_RETRIES=3
JEV_ENABLED=true
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_SECONDS=20
JEV_RETRIES=1
JEV_MINIMUM_CONFIDENCE=0.70

# Optional integration credentials; integrations are enabled in config/config.yaml.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
TESTRAIL_BASE_URL=
TESTRAIL_EMAIL=
TESTRAIL_API_KEY=
JENKINS_BASE_URL=
JENKINS_USER=
JENKINS_API_TOKEN=

# Browser proxy is optional. These values are passed to generated test processes.
# BROWSER_PROXY_URL=http://user:password@proxy.example.com:3128
# BROWSER_PROXY_BYPASS=localhost,127.0.0.1,api

# Worker deployment inputs. The identity may be generated when WORKER_ID is omitted.
AI_QA_API_URL=http://api:8000
AI_QA_AUTH_TOKEN=
WORKER_NAME=Runner-Node-1
# WORKER_ID=worker-east-1
