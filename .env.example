# Environment Configuration Template
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./runtime/ai_qa_platform.db
RUNTIME_DIR=./runtime
WORKSPACE_STORAGE_DIR=./runtime/workspaces
ARTIFACT_STORAGE_DIR=./runtime/artifacts
LOG_LEVEL=INFO
VITE_API_BASE_URL=http://localhost:8000

# Production AI Settings (Gate 5.3 & Gate 5.4)
QA_AI_PROVIDER=fake
QA_AI_BASE_URL=https://api.openai.com/v1
QA_AI_MODEL=gpt-4o-mini
QA_AI_API_KEY=
QA_AI_TIMEOUT=30
QA_AI_MAX_RETRIES=3

# AI Budget Guards (Gate 5.11)
QA_AI_MAX_REQUESTS_PER_RUN=50
QA_AI_MAX_INPUT_TOKENS_PER_RUN=100000
QA_AI_MAX_OUTPUT_TOKENS_PER_RUN=50000

# Jenkins Runner Settings (Gate 7.2)
JENKINS_BASE_URL=
JENKINS_USER=
JENKINS_API_TOKEN=
