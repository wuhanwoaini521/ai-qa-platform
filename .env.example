# ==============================================================================
# AI QA Platform — Environment Configuration Template
# Copy this file to `.env` and fill in the values for your environment.
#
# Every variable below is read by the code. Variables that are commented out are
# optional: leaving them unset keeps the platform running in its deterministic
# fallback mode (fake AI provider, dry-run integrations).
# ==============================================================================

# --- Application & Network ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://qa.yourdomain.com"]
# Optional proxy for recorder, AI page exploration and generated browser tests.
# BROWSER_PROXY_URL=http://user:password@proxy.example.com:3128
# BROWSER_PROXY_BYPASS=localhost,127.0.0.1,api

# --- Database (PostgreSQL / SQLite) ---
# PostgreSQL (production):
DATABASE_URL=postgresql+asyncpg://aiqa:aiqa_secret_password@postgres:5432/ai_qa_platform
POSTGRES_DB=ai_qa_platform
POSTGRES_USER=aiqa
POSTGRES_PASSWORD=aiqa_secret_password
# SQLite (local development):
# DATABASE_URL=sqlite+aiosqlite:///./runtime/ai_qa_platform.db

# --- Authentication ---
# Every route except the health probes, `/api/metrics` and `/api/auth/login` requires a bearer
# token. Set to `false` only for local throwaway development: the API then treats every request as
# the seeded administrator.
AUTH_REQUIRED=true
# Secrets used to encrypt stored secrets (SecretStore). Generate with: openssl rand -hex 32
APP_SECRET_KEY=replace-with-a-32-byte-random-hex-string

# --- AI Provider (optional) ---
# `fake` (default) keeps the platform deterministic and offline.
# `openai-compatible` works with OpenAI, Azure OpenAI, vLLM, Ollama or any compatible gateway.
QA_AI_PROVIDER=fake
QA_AI_API_KEY=
QA_AI_BASE_URL=https://api.openai.com/v1
QA_AI_MODEL=gpt-4o-mini
QA_AI_TIMEOUT=30.0
QA_AI_MAX_RETRIES=3

# --- Decision Layer: Jev (optional, disabled by default) ---
# The Settings page can manage these values at runtime; APP_SECRET_KEY protects saved API keys.
JEV_ENABLED=false
JEV_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_TIMEOUT=20.0
JEV_MINIMUM_CONFIDENCE=0.60

# --- Integrations (optional; each falls back to a dry-run fake adapter when unset) ---
# GitHub pull requests
GITHUB_TOKEN=

# Jira requirement sync
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# TestRail result publishing
TESTRAIL_BASE_URL=
TESTRAIL_EMAIL=
TESTRAIL_API_KEY=

# Jenkins runner
JENKINS_BASE_URL=
JENKINS_USER=
JENKINS_API_TOKEN=

# --- Distributed Workers ---
# Workers call the API over HTTP and must present a bearer token (create one under
# Security → API Keys, or log in and copy the session token).
AI_QA_API_URL=http://api:8000
AI_QA_AUTH_TOKEN=
WORKER_NAME=Runner-Node-1
MAX_CONCURRENCY=4
WORKER_CAPABILITIES=playwright,chromium,firefox,webkit,pytest,python3
HEARTBEAT_INTERVAL_SECONDS=10.0
POLL_INTERVAL_SECONDS=3.0

# --- Object storage (reserved) ---
# NOT IMPLEMENTED YET: artifacts are written to the API's local artifact directory.
# These variables are kept so existing deployments do not break; setting them has no effect.
# S3_ENDPOINT_URL=
# S3_BUCKET_NAME=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
