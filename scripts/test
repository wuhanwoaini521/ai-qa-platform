#!/usr/bin/env bash
# Thin wrapper: the implementation lives in scripts/task.py so macOS, Linux and Windows
# run the exact same steps. Prefer `pnpm test` or `make test`.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

exec "${AI_QA_PYTHON:-python3}" scripts/task.py test
