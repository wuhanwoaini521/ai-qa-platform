 the email\n            recorder_secret_2 = os.getenv(\"QA_RECORDER_SECRET_8290261013CE\")  # qa_step_id=8290261013ce qa_evidence_id=recorder:8290261013ce\n            if recorder_secret_2 is None: raise RuntimeError(\"Set environment variable QA_RECORDER_SECRET_8290261013CE\")  # qa_step_id=8290261013ce qa_evidence_id=recorder:8290261013ce\n            page.locator(\"#login-email\").fill(recorder_secret_2)  # qa_step_id=8290261013ce qa_evidence_id=recorder:8290261013ce\n            # Step 3: Check the title\n            expect(page).to_have_title(re.compile(\"AI QA Platform\"))  # qa_step_id=60b4d9d55abe qa_evidence_id=recorder:60b4d9d55abe\n        finally:\n            browser.close()\n", "project_id": "proj_9f8b808ac8ab", "variables": [{"name": "QA_BASE_URL", "default": "http://127.0.0.1:5183", "source": "url", "step_id": "navigate", "hint": ""}]}, "saved": {"test_case": {"id": "tc_rec_253b9170bf966540a17cf8a67b0cb", "project_id": "proj_9f8b808ac8ab", "requirement_id": null, "test_design_id": null, "title": "Recorded app shell smoke", "preconditions": "", "steps": ["open the app shell", "fill the email", "check the title"], "expected_result": "", "test_model": null, "priority": "P1", "automation_status": "AUTOMATED", "tags": [], "external_system": "RECORDER", "external_case_id": "253b9170bf966540a17cf8a67b0cb", "external_url": null, "created_at": "2026-10-31T22:50:58.549803+00:00", "updated_at": "2026-10-31T22:50:58.576137+00:00", "binding": null}, "binding": {"test_case_id": "tc_rec_253b9170bf966540a17cf8a67b0cb", "workspace_id": "proj_9f8b808ac8ab", "nodeid": "tests/test_recorder_e2e.py::test_recorder_e2e", "file_path": "tests/test_recorder_e2e.py", "framework": "playwright_python", "status": "ACTIVE", "id": "bind_e9cf215047e1", "created_at": "2026-10-31T22:50:58.569558Z", "updated_at": "2026-10-31T22:50:58.569558Z", "recorder_steps": []}, "nodeid": "tests/test_recorder_e2e.py::test_recorder_e2e", "reused": false}, "run": {"id": "run_a0c6b49f0dbc", "task_id": 