    "code": "import json\nimport os\n\nimport httpx\n\n\ndef _value_at(payload, path):\n    current = payload\n    for part in path.split('.'):\n        if part.endswith(']') and '[' in part:\n            name, index = part[:-1].split('[', 1)\n            if name:\n                current = current[name]\n            current = current[int(index)]\n        else:\n            current = current[part]\n    return current\n\n\ndef test_get_api_info():\n    base = os.getenv(\"QA_BASE_URL\", \"http://127.0.0.1:8099\")\n    url = base + \"/api/info\"\n    headers = {}\n    response = httpx.request(\"GET\", url, headers=headers, timeout=30.0, follow_redirects=True)\n    assert response.status_code == 200, response.text[:500]\n"
