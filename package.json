{
  "name": "ai-qa-platform-root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "python scripts/task.py setup",
    "dev": "python scripts/task.py dev",
    "dev:web": "pnpm --filter @ai-qa/web dev",
    "build": "pnpm --filter @ai-qa/web build",
    "lint": "python scripts/task.py lint",
    "lint:web": "pnpm --filter @ai-qa/web lint",
    "typecheck": "pnpm --filter @ai-qa/web typecheck",
    "api:contract": "uv run --no-sync python scripts/export_openapi.py && pnpm --filter @ai-qa/web api:types",
    "test": "python scripts/task.py test",
    "clean": "python scripts/task.py clean"
  },
  "packageManager": "pnpm@12.5.1"
}
